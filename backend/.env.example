# ---------------------------------------------------------------------------
# Copy to `.env`. Every value is optional: the Android app can send the three
# API keys per request (X-Puter-Key / X-NIM-Key / X-YouTube-Token) instead.
# ---------------------------------------------------------------------------

# --- Puter.js (TTS, txt2img stickers, inpainting) ---------------------------
PUTER_API_KEY=
PUTER_BASE_URL=https://api.puter.com

# --- NVIDIA NIM (Kimi K3 orchestrator) --------------------------------------
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Set this to whatever Kimi build your NIM account exposes.
NIM_MODEL=moonshotai/kimi-k3-instruct
NIM_FALLBACK_MODEL=moonshotai/kimi-k2-instruct

# --- YouTube Data API v3 (reference video metadata) -------------------------
YOUTUBE_API_KEY=

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=2048
MAX_CONCURRENT_JOBS=1
JOB_RETENTION_HOURS=24

# --- Output -----------------------------------------------------------------
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
OUTPUT_FPS=60
VIDEO_BITRATE=12M
X264_PRESET=medium
X264_CRF=20

# --- Captions ---------------------------------------------------------------
# tiny | base | small | medium | large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
ENABLE_CAPTIONS=true

# --- Stickers / inpainting --------------------------------------------------
REMBG_MODEL=isnet-general-use
INPAINT_FPS=2.0
INPAINT_MAX_FRAMES_PER_SEGMENT=24
